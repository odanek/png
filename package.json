{
  "name": "@odanek/png",
  "version": "0.1.0",
  "description": "PNG format decoder and coder for web and NodeJS",
  "keywords": [],
  "homepage": "https://github.com/odanek/png#readme",
  "bugs": {
    "url": "https://github.com/odanek/png/issues"
  },
  "license": "MIT",
  "author": "Ondrej Danek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odanek/png.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:update": "node test/scripts/generate-inputs.ts && UPDATE_FIXTURES=1 vitest run test/decode.test.ts test/encode.test.ts"
  }
}
